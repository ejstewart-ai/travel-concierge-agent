# ==============================================================================
# Travel Concierge Agent - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# NEVER commit your real `.env` file or API keys to Git!
# In production (Cloud Run / Vertex AI), secrets are injected from Google Cloud
# Secret Manager automatically via Terraform (`deployment/terraform/secret_manager.tf`).
# ==============================================================================

# --- Option A: Quick Local Start with Google AI Studio (Recommended for Dev) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key-here

# --- Option B: Google Cloud / Vertex AI (Recommended for Production) ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Strategic Model Routing ---
# Lightweight / fast tasks (coordinator, parallel research, compaction)
TRAVEL_FAST_MODEL=gemini-2.5-flash
# Complex planning & self-evaluation tasks (itinerary architect, quality reviewer)
TRAVEL_REASONING_MODEL=gemini-2.5-pro

# --- Persistent Session & Memory Storage ---
# Local dev default uses async SQLite; production uses Cloud SQL PostgreSQL.
SESSION_DATABASE_URL=sqlite+aiosqlite:///./data/sessions.db
TRAVELER_MEMORY_DB_PATH=./data/traveler_memory.db

# --- Observability, Tracing & PII Redaction ---
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=travel-concierge-agent
OTEL_SDK_DISABLED=false
# Set to "cloud_trace" on GCP, "otlp" for an OTLP collector, or "memory" locally
OTEL_EXPORTER_MODE=memory
# Enable Google Cloud DLP API for PII redaction when running on GCP
ENABLE_CLOUD_DLP=false

# --- Guardrails & Secret Manager ---
# Set to true on GCP to load secrets via Secret Manager API
USE_SECRET_MANAGER=false
# Optional: Google Cloud Model Armor template resource name
# MODEL_ARMOR_TEMPLATE=projects/your-project/locations/us-central1/templates/travel-guardrail
