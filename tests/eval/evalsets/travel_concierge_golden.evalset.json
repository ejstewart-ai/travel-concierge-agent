{
  "eval_set_id": "travel_concierge_golden_v1",
  "name": "Travel Concierge Agent Golden Evaluation Suite",
  "description": "Regression benchmark covering multi-agent trip planning, preference memory, guided error recovery, safety guardrails, and HITL booking confirmation.",
  "eval_cases": [
    {
      "eval_id": "case_01_tokyo_multi_agent_trip_plan",
      "session_input": {
        "app_name": "app",
        "user_id": "eval_traveler_01",
        "state": {}
      },
      "conversation": [
        {
          "invocation_id": "inv_01",
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "Plan a 4-day trip from SFO to Tokyo (HND) from 2027-04-10 to 2027-04-14 in economy class with a total budget of $2500. I prefer boutique hotels."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "search_flight_options",
                "args": {
                  "origin_iata": "SFO",
                  "destination_iata": "HND",
                  "departure_date": "2027-04-10",
                  "return_date": "2027-04-14",
                  "cabin_class": "economy",
                  "max_price_usd": 1500
                }
              },
              {
                "name": "search_hotel_accommodations",
                "args": {
                  "destination_city": "Tokyo",
                  "check_in_date": "2027-04-10",
                  "check_out_date": "2027-04-14",
                  "max_nightly_rate_usd": 350,
                  "preferred_style": "boutique"
                }
              },
              {
                "name": "lookup_destination_travel_advisory",
                "args": {
                  "destination_city": "Tokyo",
                  "travel_month": "April"
                }
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Here is your verified 4-day Tokyo itinerary featuring ANA flight FL-SFO-HND-101 ($980) and Trunk Hotel Yoyogi Park HTL-TYO-01 ($1,180 for 4 nights), totaling $2,160 within your $2,500 budget. No reservation has been booked yet—let me know if you would like to request booking approval."
              }
            ]
          }
        }
      ]
    },
    {
      "eval_id": "case_02_save_and_recall_traveler_preference",
      "session_input": {
        "app_name": "app",
